generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  githubId      String?   @unique @map("github_id")
  elo           Int       @default(0)
  rankTier      String    @default("Bronze") @map("rank_tier")
  preferredLang String    @default("javascript") @map("preferred_lang")
  xp            Int       @default(0)
  level         Int       @default(1)
  bio           String?
  avatarUrl     String?   @map("avatar_url")
  location      String?
  website       String?
  mobileNumber         String?   @map("mobile_number")
  emailVerified        Boolean   @default(false) @map("email_verified")
  verificationToken    String?   @map("verification_token")
  verificationExpires  DateTime? @map("verification_expires")
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  deletedAt            DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  player1Duels Duel[]       @relation("Player1")
  player2Duels Duel[]       @relation("Player2")
  wonDuels     Duel[]       @relation("Winner")
  submissions  Submission[]
  eloHistory   EloHistory[]

  // Social Relations
  friendships      Friendship[]    @relation("UserFriends")
  friendOf         Friendship[]    @relation("FriendOfUsers")
  sentRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedRequests FriendRequest[] @relation("ReceivedFriendRequests")
  blockedUsers     BlockedUser[]   @relation("UserBlocked")
  blockedBy        BlockedUser[]   @relation("BlockedByUsers")
  sentMessages     DirectMessage[] @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")

  // Gamification & Tournaments
  achievements           UserAchievement[]
  wonTournaments         Tournament[]            @relation("TournamentWinner")
  tournamentParticipants TournamentParticipant[]
  tournamentPlayer1      TournamentMatch[]       @relation("TournamentPlayer1")
  tournamentPlayer2      TournamentMatch[]       @relation("TournamentPlayer2")
  tournamentMatchWins    TournamentMatch[]       @relation("TournamentMatchWinner")

  @@index([elo])
  @@map("users")
}

model Problem {
  id           String   @id @default(uuid())
  title        String
  description  String   @default("")
  difficulty   String
  examples     Json?
  constraints  Json?
  visibleTests Json     @map("visible_tests")
  hiddenTests  Json     @map("hidden_tests")
  tags         String[]
  createdAt    DateTime @default(now()) @map("created_at")

  duels           Duel[]
  dailyChallenges DailyChallenge[]

  @@map("problems")
}

model Duel {
  id        String    @id @default(uuid())
  player1Id String    @map("player1_id")
  player2Id String    @map("player2_id")
  problemId String    @map("problem_id")
  winnerId  String?   @map("winner_id")
  status    String    @default("pending")
  isRanked  Boolean   @default(true) @map("is_ranked")
  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  player1     User         @relation("Player1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2     User         @relation("Player2", fields: [player2Id], references: [id], onDelete: Cascade)
  winner      User?        @relation("Winner", fields: [winnerId], references: [id], onDelete: SetNull)
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissions Submission[]
  eloHistory  EloHistory[]

  @@index([player1Id, player2Id])
  @@map("duels")
}

model Submission {
  id              String   @id @default(uuid())
  duelId          String   @map("duel_id")
  playerId        String   @map("player_id")
  code            String
  language        String
  correctness     Decimal  @default(0)
  complexityScore Decimal  @default(0) @map("complexity_score")
  qualityScore    Decimal  @default(0) @map("quality_score")
  totalScore      Decimal  @default(0) @map("total_score")
  aiExplanation   String?  @map("ai_explanation")
  createdAt       DateTime @default(now()) @map("created_at")

  duel   Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  player User @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([duelId])
  @@map("submissions")
}

model EloHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  duelId    String   @map("duel_id")
  eloBefore Int      @map("elo_before")
  eloAfter  Int      @map("elo_after")
  delta     Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("elo_history")
}

model DailyChallenge {
  id          String   @id @default(uuid())
  problemId   String   @map("problem_id")
  date        DateTime @unique
  attempts    Int      @default(0)
  completions Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("daily_challenges")
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String   @map("reporter_id")
  reportedId  String?  @map("reported_id")
  type        String
  description String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOfUsers", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friendships")
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friend_requests")
}

model BlockedUser {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User @relation("UserBlocked", fields: [userId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedId])
  @@map("blocked_users")
}

model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@map("direct_messages")
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. FIRST_WIN, SPEED_DEMON, STREAK_5, TOURNAMENT_CHAMPION
  title       String
  description String
  iconUrl     String?  @map("icon_url")
  xpReward    Int      @default(0) @map("xp_reward")
  eloReward   Int      @default(0) @map("elo_reward")
  isSecret    Boolean  @default(false) @map("is_secret")
  createdAt   DateTime @default(now()) @map("created_at")

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Tournament {
  id              String    @id @default(uuid())
  title           String
  description     String
  imageUrl        String?   @map("image_url")
  minElo          Int       @default(0) @map("min_elo")
  maxPlayers      Int       @default(8) @map("max_players")
  rewardBadgeCode String?   @default("TOURNAMENT_CHAMPION") @map("reward_badge_code")
  startDate           DateTime? @map("start_date")
  bracketGeneratedAt DateTime? @map("bracket_generated_at")
  status              String    @default("UPCOMING") // UPCOMING, REGISTRATION_CLOSED, IN_PROGRESS, COMPLETED
  winnerId        String?   @map("winner_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  winner       User?                   @relation("TournamentWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  participants TournamentParticipant[]
  matches      TournamentMatch[]

  @@map("tournaments")
}

model TournamentParticipant {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  userId       String   @map("user_id")
  status       String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  seed         Int?
  isEliminated Boolean  @default(false) @map("is_eliminated")
  appliedAt    DateTime @default(now()) @map("applied_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_participants")
}

model TournamentMatch {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  round        Int      // 1 = Quarterfinals, 2 = Semifinals, 3 = Finals
  matchNumber  Int      @map("match_number")
  player1Id    String?  @map("player1_id")
  player2Id    String?  @map("player2_id")
  winnerId     String?  @map("winner_id")
  duelId       String?  @unique @map("duel_id")
  status       String   @default("PENDING") // PENDING, READY, IN_PROGRESS, COMPLETED

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    User?      @relation("TournamentPlayer1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2    User?      @relation("TournamentPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  winner     User?      @relation("TournamentMatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@map("tournament_matches")
}
